# H5 开发与打包统一配置（npm run dev:h5 / build:h5 使用 --mode production 加载本文件）

# 后端接口域名（勿以 / 结尾；H5 本地 dev 会自动走 /api 代理）
VITE_API_BASE_URL=https://api.luanjt.com/api

# Vite 开发代理目标（仅 dev:h5 使用，须用 https 避免 301 重定向）
VITE_API_PROXY_TARGET=https://api.luanjt.com

# 接口 params 公共字段（与后端约定）
VITE_API_MODULE=usermgr
VITE_API_LANG=zh
# 高德地图 Web 端 Key（JS API 2.0）
# 控制台：https://console.amap.com/dev/key/app
VITE_AMAP_KEY=112c0845bb2100d87b5ad713fd14dff6

# 安全密钥（2021年12月后申请的 Key 通常需要）
VITE_AMAP_SECURITY_CODE=
