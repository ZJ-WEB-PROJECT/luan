# # 高德地图 Web 端 Key（JS API 2.0）
# # 控制台：https://console.amap.com/dev/key/app
# VITE_AMAP_KEY=key

# # 安全密钥（2021年12月后申请的 Key 通常需要）
# VITE_AMAP_SECURITY_CODE=密钥
# 后端接口域名（勿以 / 结尾；H5 本地 dev 会自动走 /api 代理）
VITE_API_BASE_URL=https://api.luanjt.com/api

# Vite 开发代理目标（仅 dev:h5 使用，须用 https 避免 301 重定向）
VITE_API_PROXY_TARGET=https://api.luanjt.com

# 接口 params 公共字段（与后端约定）
VITE_API_MODULE=usermgr
VITE_API_LANG=zh

# 高德地图 Web 端 Key（JS API 2.0）
# 控制台：https://console.amap.com/dev/key/app
VITE_AMAP_KEY=bd7b5f8db843c0bf1b9a857e4926956d

# 安全密钥（2021年12月后申请的 Key 通常需要）
VITE_AMAP_SECURITY_CODE=f545304b33ccf49725a4cb985b7b4421

# Web服务 Key（REST 逆地理编码，App 端兜底；须与 JS API Key 分开申请）
# VITE_AMAP_WEB_SERVICE_KEY=

# 微信分享（App 分享小程序卡片需填写小程序原始 ID，如 gh_xxxx）
# VITE_WX_GH_ID=
# VITE_WX_APPID=wx91430f07c061c0ef
# H5 分享落地页域名（不配则用 VITE_API_PROXY_TARGET）
# VITE_H5_BASE_URL=